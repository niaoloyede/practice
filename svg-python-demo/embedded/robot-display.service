# Example systemd unit — copy to /etc/systemd/system/robot-display.service
# and: sudo systemctl enable robot-display.service
#
# Your Python state machine can be a separate service; this one only
# brings up the fullscreen SVG after the display is ready.

[Unit]
Description=Robot boot SVG (kiosk)
After=graphical-session.target network-online.target
Wants=graphical-session.target
# If your state machine must start first and create the SVG path:
# After=robot-statemachine.service

[Service]
Type=simple
Environment=ROBOT_SVG=/opt/robot/ui/animation.svg
ExecStart=/opt/robot/ui/start_kiosk.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
